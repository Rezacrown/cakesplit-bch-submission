# ==============================================================================
# CakeSplit — Environment Configuration
# Copy to `.env.local` for local overrides or set in Vercel Project Settings.
# Changing your domain, Slides URL, or donation address requires ZERO code edits.
# ==============================================================================

# Public application URL (optional).
# Leave blank in browser builds to auto-detect `window.location.origin` (works
# seamlessly when attaching a custom domain on Vercel), or set explicitly to
# control canonical metadata & share URLs.
NEXT_PUBLIC_APP_URL=https://cakesplit-bch.vercel.app
NEXT_PUBLIC_APP_NAME=CakeSplit

# BCH BLAZE 2026 Top Banner & Project Links
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/Rezacrown/cakesplit-bch-submission
# Public Widget Factory Google Slides share URL:
NEXT_PUBLIC_SLIDES_URL=https://docs.google.com/presentation/d/1MWgxqhW43VwhE9tCDykVvCvQUX3ljzvHgSwMqDwQqhs/edit?usp=sharing
# CashTokens-aware `bitcoincash:z...` address for EMBER2026 Community Choice voting:
NEXT_PUBLIC_EMBER_ADDRESS=bitcoincash:zr4jg99w7eeupyd9hch370t3ffkd8kmmfs9y4g5aqe
NEXT_PUBLIC_XO_DEBUG_TOOL_URL=https://blaze.xo.cash/

# Bitcoin Cash Mainnet Infrastructure (optional overrides)
# Comma-separated Fulcrum WSS endpoints (`host:port`):
NEXT_PUBLIC_ELECTRUM_MAINNET_SERVERS=bch.imaginary.cash:50004,electrum.imaginary.cash:50004,cashnode.bch.ninja:50004,fulcrum.greyh.at:50004
NEXT_PUBLIC_EXPLORER_MAINNET_URL=https://explorer.bch.ninja
NEXT_PUBLIC_FALLBACK_BCH_USD_PRICE=200
